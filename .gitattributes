# 统一换行符，避免脚本在 Linux 上因 CRLF 报错
*.sh          text eol=lf
*.bash        text eol=lf
*.py          text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.ps1         text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# 二进制资源不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.apk   binary
*.aab   binary
*.pth   binary
*.zip   binary
