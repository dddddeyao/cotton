# Public access
BACKEND_PUBLIC_PORT=8080
APP_CORS_ALLOWED_ORIGINS=*
APP_CORS_ALLOW_CREDENTIALS=false

# MySQL
MYSQL_DATABASE=cotton_db
MYSQL_USER=cotton_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MYSQL_PUBLIC_PORT=127.0.0.1:3306

# Backend
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Required: Base64 HMAC key, at least 32 decoded bytes. Do not use a shared default.
JWT_SECRET=
JWT_EXPIRATION=604800000
PYTHON_SERVICE_CONNECT_TIMEOUT_MS=5000
PYTHON_SERVICE_READ_TIMEOUT_MS=180000
APP_UPLOAD_DIR=/app/uploads

