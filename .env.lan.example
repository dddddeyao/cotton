# Copy this file to .env for one-computer LAN deployment.
# Replace 192.168.1.100 with the LAN IPv4 address of the host computer.

# LAN access
LAN_HOST_IP=192.168.1.100
BACKEND_PUBLIC_PORT=8088
APP_CORS_ALLOWED_ORIGINS=*
APP_CORS_ALLOW_CREDENTIALS=false

# MySQL runs inside Docker. It is bound to localhost on the host for safety.
MYSQL_DATABASE=cotton_db
MYSQL_USER=cotton_user
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PUBLIC_PORT=127.0.0.1:3306

# Backend
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Required: Base64 HMAC key, at least 32 decoded bytes. Do not use a shared default.
JWT_SECRET=
JWT_EXPIRATION=604800000
PYTHON_SERVICE_CONNECT_TIMEOUT_MS=5000
PYTHON_SERVICE_READ_TIMEOUT_MS=180000
# 模型推理服务地址；部署脚本会按平台自动改写（Windows=host.docker.internal，Linux=model-service）
PYTHON_SERVICE_URL=http://host.docker.internal:5000
APP_UPLOAD_DIR=/app/uploads
