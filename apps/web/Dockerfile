FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=/api
ARG VITE_MOCK_WHEN_API_UNAVAILABLE=false
ARG VITE_REQUEST_TIMEOUT_MS=15000
ARG VITE_RECOGNITION_TIMEOUT_MS=30000
ARG VITE_RECOGNITION_UPLOAD_FIELD_NAME=file

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_MOCK_WHEN_API_UNAVAILABLE=$VITE_MOCK_WHEN_API_UNAVAILABLE
ENV VITE_REQUEST_TIMEOUT_MS=$VITE_REQUEST_TIMEOUT_MS
ENV VITE_RECOGNITION_TIMEOUT_MS=$VITE_RECOGNITION_TIMEOUT_MS
ENV VITE_RECOGNITION_UPLOAD_FIELD_NAME=$VITE_RECOGNITION_UPLOAD_FIELD_NAME

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
